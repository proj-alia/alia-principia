digraph G {
graph [rankdir=TB, bgcolor="transparent", fontname="Noto Sans CJK SC", fontsize=16, nodesep=0.32, ranksep=0.62, pad=0.25, splines=polyline, newrank=true, compound=true];
node [shape=box, fontname="Noto Sans CJK SC", fontsize=13, margin="0.11,0.08", penwidth=1.1];
edge [fontname="Noto Sans CJK SC", fontsize=10, arrowsize=0.65, penwidth=1.15, color="#5c7897"];
subgraph cluster_0 { label="工作台 (Workbench)"; style="rounded,filled"; fillcolor="#f6f9fc"; color="#dce5ee"; fontsize=14; margin=16;
"UI-ROOT" [id="node-UI-ROOT", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">UI-ROOT · WebUI 面板前端</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>WebUI 控制台根壳与实时同步栏</B></TD></TR><TR><TD ALIGN="LEFT"><B>apps/webui/src/App.vue</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#265782">WebUIConsoleApp</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#586c80">src/App.vue:1</FONT></TD></TR></TABLE>>, fillcolor="#ffffff", color="#afbed0", style="rounded,filled", URL="./apps/webui/src/App.vue#L1", target="_blank", tooltip="项目唯一的内置控制台界面：顶部维护本机实例授权状态与 REST + SSE 实时同步连接，左侧组织四大分组导航（工作台、数字个体、连接与能力、配置与运行）。"];
"UI-OVERVIEW" [id="node-UI-OVERVIEW", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">UI-OVERVIEW · WebUI 面板前端</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>运行概览面板</B></TD></TR><TR><TD ALIGN="LEFT"><B>apps/webui/src/pages/workbench/overview.vue</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#265782">WorkbenchOverviewPage</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#586c80">workbench/overview.vue:1</FONT></TD></TR></TABLE>>, fillcolor="#ffffff", color="#afbed0", style="rounded,filled", URL="./apps/webui/src/pages/workbench/overview.vue#L1", target="_blank", tooltip="汇总展示本机实例运行健康度、当前四维模型使用分工、已启用接入渠道与扩展插件数量及近期活动摘要。"];
"UI-SANDBOX" [id="node-UI-SANDBOX", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">UI-SANDBOX · WebUI 面板前端</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>测试沙盒（内置直接对话体验台）</B></TD></TR><TR><TD ALIGN="LEFT"><B>apps/webui/src/pages/workbench/sandbox.vue</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#265782">WorkbenchSandboxPage</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#586c80">workbench/sandbox.vue:1</FONT></TD></TR></TABLE>>, fillcolor="#ffffff", color="#afbed0", style="rounded,filled", URL="./apps/webui/src/pages/workbench/sandbox.vue#L1", target="_blank", tooltip="在项目 WebUI 面板内提供直接与数字个体对话的多模态与语音体验功能，实时观测日常对话/内部推理/目标决策输出、记忆召回与工具执行结果，支撑开发验证与开箱体验。"];
}
subgraph cluster_1 { label="数字个体 (Digital Individual)"; style="rounded,filled"; fillcolor="#f6f9fc"; color="#dce5ee"; fontsize=14; margin=16;
"UI-IDENTITY" [id="node-UI-IDENTITY", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">UI-IDENTITY · WebUI 面板前端</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>身份与人格配置页</B></TD></TR><TR><TD ALIGN="LEFT"><B>apps/webui/src/pages/individual/identity.vue</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#265782">IdentityAndPersonaPage</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#586c80">individual/identity.vue:1</FONT></TD></TR></TABLE>>, fillcolor="#ffffff", color="#afbed0", style="rounded,filled", URL="./apps/webui/src/pages/individual/identity.vue#L1", target="_blank", tooltip="编辑数字个体的核心身份、性格设定与模块配置继承（对接专题 03 alia-core-character），底层切换模型服务时身份持续保留。"];
"UI-MEMORY" [id="node-UI-MEMORY", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">UI-MEMORY · WebUI 面板前端</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>记忆管理与笔记页</B></TD></TR><TR><TD ALIGN="LEFT"><B>apps/webui/src/pages/individual/memory.vue</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#265782">MemoryManagementPage</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#586c80">individual/memory.vue:1</FONT></TD></TR></TABLE>>, fillcolor="#ffffff", color="#afbed0", style="rounded,filled", URL="./apps/webui/src/pages/individual/memory.vue#L1", target="_blank", tooltip="检索、编辑、固定与遗忘长期记忆条目（MemoryEntry）及持久笔记（Notebook，对接专题 09/10/11），底层切换模型服务时记忆持续保留。"];
}
subgraph cluster_2 { label="连接与能力 (Connections &amp; Capabilities)"; style="rounded,filled"; fillcolor="#f6f9fc"; color="#dce5ee"; fontsize=14; margin=16;
"UI-CHANNELS" [id="node-UI-CHANNELS", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">UI-CHANNELS · WebUI 面板前端</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>接入渠道管理页</B></TD></TR><TR><TD ALIGN="LEFT"><B>apps/webui/src/pages/capabilities/channels.vue</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#265782">ConnectedChannelsPage</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#586c80">capabilities/channels.vue:1</FONT></TD></TR></TABLE>>, fillcolor="#ffffff", color="#afbed0", style="rounded,filled", URL="./apps/webui/src/pages/capabilities/channels.vue#L1", target="_blank", tooltip="配置与监控通过 alia-channel-gateway（专题 19）接入的所有外部可扩展渠道（外部聊天端、IM、外部表现客户端、语音终端等）。"];
"UI-MODELS" [id="node-UI-MODELS", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">UI-MODELS · WebUI 面板前端</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>模型服务与四维使用分工页</B></TD></TR><TR><TD ALIGN="LEFT"><B>apps/webui/src/pages/capabilities/models.vue</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#265782">ModelServicesPage</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#586c80">capabilities/models.vue:1</FONT></TD></TR></TABLE>>, fillcolor="#ffffff", color="#afbed0", style="rounded,filled", URL="./apps/webui/src/pages/capabilities/models.vue#L1", target="_blank", tooltip="管理已接入模型服务地址与密钥、获取或手动添加模型、执行批量并发探活测试（每次最多 6 个并行调用并计入健康度），并独立配置 Alia 使用分工（日常对话 / 后台活动 / 内部推理 / 目标决策，对接专题 07）。"];
"UI-EXTENSIONS" [id="node-UI-EXTENSIONS", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">UI-EXTENSIONS · WebUI 面板前端</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>扩展管理页（插件中心）</B></TD></TR><TR><TD ALIGN="LEFT"><B>apps/webui/src/pages/capabilities/extensions.vue</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#265782">ExtensionsManagementPage</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#586c80">capabilities/extensions.vue:1</FONT></TD></TR></TABLE>>, fillcolor="#ffffff", color="#afbed0", style="rounded,filled", URL="./apps/webui/src/pages/capabilities/extensions.vue#L1", target="_blank", tooltip="管理通过 alia-extension-host 与 alia-plugin-protocol（专题 17/18）加载的外部插件扩展（安装目录、启停控制、Kit 插槽与动态工具租约）。"];
"UI-SKILLS" [id="node-UI-SKILLS", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">UI-SKILLS · WebUI 面板前端</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>技能管理页</B></TD></TR><TR><TD ALIGN="LEFT"><B>apps/webui/src/pages/capabilities/skills.vue</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#265782">SkillsManagementPage</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#586c80">capabilities/skills.vue:1</FONT></TD></TR></TABLE>>, fillcolor="#ffffff", color="#afbed0", style="rounded,filled", URL="./apps/webui/src/pages/capabilities/skills.vue#L1", target="_blank", tooltip="管理数字个体可调用的内建与扩展工具定义、可复用技能配方（Recipe，对接专题 08/09）及启用策略。"];
}
